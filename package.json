{
  "name": "github-actions",
  "version": "14.8.2",
  "description": "Common GitHub Actions used across my repositories.",
  "homepage": "https://github.com/AlexMan123456/github-actions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexMan123456/github-actions.git"
  },
  "sideEffects": false,
  "license": "ISC",
  "author": "alextheman",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsdown",
    "build-configs": "tsdown --config tsdown.configs.config.ts",
    "create-release": "bash -c 'git pull origin main && alex-c-line template release-note create $@ --status \"Released\" --update-version' --",
    "create-release-note": "bash -c 'git pull origin main && alex-c-line template release-note create $@' --",
    "format": "pnpm run format-oxfmt && pnpm run format-eslint && pnpm run format-markdownlint",
    "format-eslint": "eslint --fix --suppress-all package.json \"{src,configs}/**/*.ts\" && rm -f eslint-suppressions.json",
    "format-markdownlint": "pnpm exec markdownlint-cli2 --fix \"**/*.md\" \"!{node_modules,dist}/**\" | grep -v \"^Finding:\"",
    "format-oxfmt": "oxfmt \"./**/*.{ts,js,yml,yaml}\"",
    "lint": "pnpm run lint-tsc && pnpm run lint-eslint && pnpm run lint-markdownlint && pnpm run lint-oxfmt",
    "lint-eslint": "eslint package.json \"{src,configs}/**/*.ts\"",
    "lint-markdownlint": "bash -o pipefail -c 'pnpm exec markdownlint-cli2 \"**/*.md\" \"!{node_modules,dist}/**\"| grep -v \"^Finding:\"'",
    "lint-oxfmt": "oxfmt --check \"./**/*.{ts,js,yml,yaml,html}\"",
    "lint-tsc": "tsc --noEmit",
    "pre-commit": "pnpm run build-configs && alex-c-line pre-commit",
    "prepare": "husky",
    "update-dependencies": "pnpm update --latest && pnpm update"
  },
  "devDependencies": {
    "@alextheman/eslint-plugin": "5.18.9",
    "@types/node": "26.6.6",
    "@typescript-eslint/types": "8.72.1",
    "alex-c-line": "2.17.3",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "markdownlint-cli2": "0.24.0",
    "oxfmt": "0.78.0",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@alextheman/utility": "5.32.0",
    "execa": "10.2.1",
    "zod": "4.6.7"
  }
}
