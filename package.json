{
  "name": "github-actions",
  "version": "14.9.1",
  "description": "Common GitHub Actions used across my repositories.",
  "homepage": "https://github.com/AlexMan123456/github-actions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexMan123456/github-actions.git"
  },
  "sideEffects": false,
  "license": "ISC",
  "author": "alextheman",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsdown",
    "build-configs": "tsdown --config tsdown.configs.config.ts",
    "create-release": "bash -c 'git pull origin main && alex-c-line template release-note create $@ --status \"Released\" --update-version' --",
    "create-release-note": "bash -c 'git pull origin main && alex-c-line template release-note create $@' --",
    "format": "pnpm run format-oxlint && pnpm run format-oxfmt && pnpm run format-markdownlint",
    "format-oxlint": "oxlint --fix",
    "format-markdownlint": "pnpm exec markdownlint-cli2 --fix \"**/*.md\" \"!{node_modules,dist}/**\" | grep -v \"^Finding:\"",
    "format-oxfmt": "oxfmt \"./**/*.{ts,js,yml,yaml}\"",
    "lint": "pnpm run lint-tsc && pnpm run lint-oxlint && pnpm run lint-markdownlint && pnpm run lint-oxfmt",
    "lint-oxlint": "oxlint",
    "lint-markdownlint": "bash -o pipefail -c 'pnpm exec markdownlint-cli2 \"**/*.md\" \"!{node_modules,dist}/**\"| grep -v \"^Finding:\"'",
    "lint-oxfmt": "oxfmt --check \"./**/*.{ts,js,yml,yaml}\"",
    "lint-tsc": "tsc --noEmit",
    "pre-commit": "pnpm run build-configs && alex-c-line pre-commit",
    "prepare": "husky",
    "update-dependencies": "pnpm update --latest && pnpm update"
  },
  "devDependencies": {
    "@alextheman/configs": "1.5.2",
    "@types/node": "26.6.6",
    "@typescript-eslint/types": "8.73.0",
    "alex-c-line": "2.18.3",
    "husky": "9.1.7",
    "markdownlint-cli2": "0.24.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "tsdown": "0.23.7",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@alextheman/utility": "5.32.2",
    "execa": "10.2.1",
    "zod": "4.6.7"
  }
}
